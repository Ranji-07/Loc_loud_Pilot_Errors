{
  "name": "localpilot",
  "displayName": "LocalPilot",
  "description": "Project chat, tasks, context, agents and shared approvals for LocalPilot.",
  "version": "0.3.0",
  "publisher": "localpilot",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/apps/vscode-extension/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "LocalPilot",
      "properties": {
        "localpilot.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "LocalPilot backend URL. Must be a loopback address."
        },
        "localpilot.repoPath": {
          "type": "string",
          "default": "",
          "description": "Path to the LocalPilot repository (used by 'Start backend'). Empty = auto-detect from the open workspace."
        },
        "localpilot.pollSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5
        },
        "localpilot.droidModel": {
          "type": "string",
          "default": "",
          "description": "Droid model id to preselect in 'Ask Droid'. Empty = server default."
        }
      }
    },
    "commands": [
      {
        "command": "localpilot.openDashboard",
        "title": "LocalPilot: Open Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "localpilot.openGuide",
        "title": "LocalPilot: Open Setup Guide"
      },
      {
        "command": "localpilot.showUsage",
        "title": "LocalPilot: Show Usage"
      },
      {
        "command": "localpilot.showHealth",
        "title": "LocalPilot: Show Health"
      },
      {
        "command": "localpilot.startBackend",
        "title": "LocalPilot: Start Backend"
      },
      {
        "command": "localpilot.refresh",
        "title": "LocalPilot: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "localpilot.askDroid",
        "title": "LocalPilot: Ask Droid",
        "icon": "$(hubot)"
      },
      {
        "command": "localpilot.reviewApproval",
        "title": "LocalPilot: Review Pending Approval"
      },
      {
        "command": "localpilot.refreshApprovals",
        "title": "LocalPilot: Refresh Approvals",
        "icon": "$(refresh)"
      },
      {
        "command": "localpilot.askDroidAdvanced",
        "title": "LocalPilot: Ask Droid (Advanced Legacy Run)"
      },
      {
        "command": "localpilot.previewApproval",
        "title": "LocalPilot: Preview Proposed Diff",
        "icon": "$(diff)"
      },
      {
        "command": "localpilot.rollback",
        "title": "LocalPilot: Restore File Checkpoint",
        "icon": "$(history)"
      },
      {
        "command": "localpilot.registerProject",
        "title": "LocalPilot: Register Workspace Project",
        "icon": "$(add)"
      },
      {
        "command": "localpilot.refreshCockpit",
        "title": "LocalPilot: Refresh Coding Views",
        "icon": "$(refresh)"
      },
      {
        "command": "localpilot.attachFiles",
        "title": "LocalPilot: Attach Context Files",
        "icon": "$(add)"
      },
      {
        "command": "localpilot.openTask",
        "title": "LocalPilot: Open Task"
      },
      {
        "command": "localpilot.startTask",
        "title": "LocalPilot: Start or Retry Task",
        "icon": "$(play)"
      },
      {
        "command": "localpilot.cancelTask",
        "title": "LocalPilot: Cancel Task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "localpilot.assignTask",
        "title": "LocalPilot: Assign Task to Agent"
      },
      {
        "command": "localpilot.createAgent",
        "title": "LocalPilot: Create Agent Profile",
        "icon": "$(add)"
      },
      {
        "command": "localpilot.editAgent",
        "title": "LocalPilot: Edit Agent Profile"
      },
      {
        "command": "localpilot.toggleAgent",
        "title": "LocalPilot: Enable or Disable Agent"
      },
      {
        "command": "localpilot.editInstructions",
        "title": "LocalPilot: Edit Project Instructions"
      },
      {
        "command": "localpilot.inspectContext",
        "title": "LocalPilot: Inspect Context"
      },
      {
        "command": "localpilot.refreshContext",
        "title": "LocalPilot: Refresh Context Source",
        "icon": "$(refresh)"
      },
      {
        "command": "localpilot.addMemory",
        "title": "LocalPilot: Add Project Memory",
        "icon": "$(add)"
      },
      {
        "command": "localpilot.saveContextEditor",
        "title": "LocalPilot: Save Context or Agent Editor",
        "icon": "$(save)"
      },
      {
        "command": "localpilot.reviewSelection",
        "title": "LocalPilot: Review Selected Code"
      },
      {
        "command": "localpilot.loadMoreTasks",
        "title": "LocalPilot: Load Older Tasks"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localpilot",
          "title": "LocalPilot",
          "icon": "media/localpilot.svg"
        }
      ]
    },
    "views": {
      "localpilot": [
        {
          "id": "localpilot.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "localpilot.tasks",
          "name": "Tasks"
        },
        {
          "id": "localpilot.agents",
          "name": "Agents"
        },
        {
          "id": "localpilot.approvals",
          "name": "Changes"
        },
        {
          "id": "localpilot.context",
          "name": "Context"
        },
        {
          "id": "localpilot.health",
          "name": "Health",
          "visibility": "collapsed"
        },
        {
          "id": "localpilot.guides",
          "name": "Setup guides",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "localpilot.refresh",
          "when": "view == localpilot.health",
          "group": "navigation"
        },
        {
          "command": "localpilot.openDashboard",
          "when": "view == localpilot.health",
          "group": "navigation"
        },
        {
          "command": "localpilot.askDroid",
          "when": "view == localpilot.approvals",
          "group": "navigation"
        },
        {
          "command": "localpilot.refreshApprovals",
          "when": "view == localpilot.approvals",
          "group": "navigation"
        },
        {
          "command": "localpilot.refreshCockpit",
          "when": "view == localpilot.tasks || view == localpilot.agents || view == localpilot.context",
          "group": "navigation"
        },
        {
          "command": "localpilot.createAgent",
          "when": "view == localpilot.agents",
          "group": "navigation"
        },
        {
          "command": "localpilot.attachFiles",
          "when": "view == localpilot.context",
          "group": "navigation"
        },
        {
          "command": "localpilot.addMemory",
          "when": "view == localpilot.context",
          "group": "navigation"
        },
        {
          "command": "localpilot.rollback",
          "when": "view == localpilot.approvals",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "localpilot.startTask",
          "when": "view == localpilot.tasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "localpilot.cancelTask",
          "when": "view == localpilot.tasks && viewItem == activeTask",
          "group": "inline"
        },
        {
          "command": "localpilot.assignTask",
          "when": "view == localpilot.tasks && viewItem == task"
        },
        {
          "command": "localpilot.toggleAgent",
          "when": "view == localpilot.agents && viewItem == agentProfile"
        },
        {
          "command": "localpilot.refreshContext",
          "when": "view == localpilot.context && viewItem == contextItem",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "localpilot.health",
        "contents": "The LocalPilot backend is not reachable.\n[Start backend](command:localpilot.startBackend)\n[Open dashboard](command:localpilot.openDashboard)"
      },
      {
        "view": "localpilot.approvals",
        "contents": "Nothing is waiting for approval.\n[Open native Git](command:workbench.view.scm)\n[Inspect file checkpoints](command:localpilot.rollback)"
      }
    ],
    "keybindings": [
      {
        "command": "localpilot.askDroid",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "localpilot.reviewSelection",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorHasSelection"
      },
      {
        "command": "localpilot.saveContextEditor",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "package": "tsc -p . && vsce package --allow-missing-repository --skip-license --out localpilot-0.3.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "~5.9.0"
  }
}
